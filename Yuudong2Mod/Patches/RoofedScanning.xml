<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Roofed Scanning 포팅: 스캐너를 지붕 아래에도 지을 수 있게 한다. Odyssey 궤도 탐지기도 같이 푼다(Odyssey가 없으면 나머지만 걸린다). -->
  <Operation Class="Yuudong2Mod.PatchOperationFeature">
    <feature>RoofedScanning</feature>
    <enabled Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="GroundPenetratingScanner" or defName="LongRangeMineralScanner" or defName="OrbitalScanner"]/canBeUsedUnderRoof</xpath>
          <value>
            <canBeUsedUnderRoof>true</canBeUsedUnderRoof>
          </value>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>/Defs/ThingDef[defName="GroundPenetratingScanner" or defName="LongRangeMineralScanner" or defName="OrbitalScanner"]/placeWorkers/li[text()="PlaceWorker_NotUnderRoof"]</xpath>
        </li>
      </operations>
    </enabled>
  </Operation>

</Patch>
