<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 세력 전쟁: 세계 지도 위를 걸어가는 군대(Source/FactionWar.cs). 그림은 바닐라 상단 아이콘에 세력 색을 입힌다. -->
  <WorldObjectDef>
    <defName>Yuudong2_WarArmy</defName>
    <label>army</label>
    <description>An army marching to attack an enemy settlement.</description>
    <worldObjectClass>Yuudong2Mod.WorldObject_WarArmy</worldObjectClass>
    <texture>World/WorldObjects/Caravan</texture>
    <useDynamicDrawer>true</useDynamicDrawer>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/Caravan</expandingIconTexture>
    <expandingIconPriority>90</expandingIconPriority>
    <expandMore>true</expandMore>
  </WorldObjectDef>

  <!-- 행군 중인 군대를 기습해서 열린 임시 전투 맵(Source/ArmyAttack.cs). -->
  <WorldObjectDef ParentName="StaticWorldObjectBase">
    <defName>Yuudong2_ArmyBattle</defName>
    <label>army battle</label>
    <description>A battle with an army ambushed on the march.</description>
    <worldObjectClass>Yuudong2Mod.WorldObject_ArmyBattle</worldObjectClass>
    <texture>World/WorldObjects/Ambush</texture>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>World/WorldObjects/Expanding/Ambush</expandingIconTexture>
    <expandingIconPriority>80</expandingIconPriority>
    <expandMore>true</expandMore>
    <isTempIncidentMapOwner>true</isTempIncidentMapOwner>
    <IncidentTargetTags>
      <li>Map_TempIncident</li>
    </IncidentTargetTags>
    <comps>
      <li Class="WorldObjectCompProperties_FormCaravan" />
    </comps>
  </WorldObjectDef>

</Defs>
