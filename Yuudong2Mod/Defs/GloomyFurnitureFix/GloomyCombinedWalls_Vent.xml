<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- Yuudong2Mod: Gloomy 환풍벽 + 강화 벽/항균 벽 조합. GloomyFurniture (Continued)의 환풍벽 텍스처와 열고 닫기 컴프를 쓴다. -->
	<ThingDef ParentName="RKGFence" MayRequire="Gloomy.Furniture.Continued,yuudong2.yuudong2mod">
		<defName>GL_HeavyVentWall</defName>
		<label>reinforced vent wall</label>
		<thingClass>Building_Vent</thingClass>
		<category>Building</category>
		<description>A strong Gloomy vent wall. Air can pass through it when open. Explosion resistant.</description>
		<graphicData>
			<texPath>Things/Building/Linked/GL_VentWall</texPath>
			<graphicClass>Graphic_Appearances</graphicClass>
			<linkType>CornerFiller</linkType>
			<linkFlags>
				<li>Wall</li>
				<li>Rock</li>
			</linkFlags>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
				<edgeTop>Damage/Edge</edgeTop>
				<edgeBot>Damage/Edge</edgeBot>
				<edgeLeft>Damage/Edge</edgeLeft>
				<edgeRight>Damage/Edge</edgeRight>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Linked/GL_VentWall_MenuIcon</uiIconPath>
		<stuffCategories>
			<li>Woody</li>
			<li>Stony</li>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>15</costStuffCount>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<altitudeLayer>Building</altitudeLayer>
		<passability>Impassable</passability>
		<castEdgeShadows>true</castEdgeShadows>
		<fillPercent>1</fillPercent>
		<coversFloor>true</coversFloor>
		<tickerType>Rare</tickerType>
		<rotatable>true</rotatable>
		<selectable>true</selectable>
		<terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
		<holdsRoof>true</holdsRoof>
		<staticSunShadowHeight>1</staticSunShadowHeight>
		<blockLight>true</blockLight>
		<placeWorkers>
			<li>PlaceWorker_Vent</li>
		</placeWorkers>
		<blockWind>true</blockWind>
		<filthLeaving>Filth_RubbleBuilding</filthLeaving>
		<drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
		<building>
			<blueprintGraphicData>
				<texPath>Things/Building/Linked/RGK_VentWall_Blueprint_Atlas</texPath>
			</blueprintGraphicData>
			<isInert>true</isInert>
			<isPlaceOverableWall>true</isPlaceOverableWall>
			<ai_chillDestination>false</ai_chillDestination>
			<supportsWallAttachments>true</supportsWallAttachments>
			<canPlaceOverWall>true</canPlaceOverWall>
			<relatedBuildCommands>
				<li>RGK_DoorOld</li>
				<li>RGK_AutodoorOld</li>
				<li>OrnateDoor</li>
				<li MayRequire="Ludeon.RimWorld.Anomaly">SecurityDoor</li>
				<li MayRequire="Ludeon.RimWorld.Odyssey">VacBarrier</li>
				<li>Cooler</li>
				<li>Vent</li>
			</relatedBuildCommands>
			<paintable>true</paintable>
			<canExchangeVacuum>true</canExchangeVacuum>
			<isAirtight>true</isAirtight>
		</building>
		<comps>
			<li Class="Gloomylynx.CompProperties_FlickableVent">
				<commandTexture>UI/Commands/Vent</commandTexture>
				<commandLabelKey>CommandDesignateOpenCloseVentLabel</commandLabelKey>
				<commandDescKey>CommandDesignateOpenCloseVentDesc</commandDescKey>
			</li>
		</comps>
		<designationCategory>Structure</designationCategory>
		<statBases>
			<MaxHitPoints>900</MaxHitPoints>
			<WorkToBuild>415</WorkToBuild>
			<Flammability>0</Flammability>
			<MeditationFocusStrength>0.22</MeditationFocusStrength>
		</statBases>
		<costList>
			<Steel>5</Steel>
		</costList>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>ResearchGLReinforcedWalls</li>
		</researchPrerequisites>
		<damageMultipliers>
			<li>
				<damageDef>Bomb</damageDef>
				<multiplier>0.5</multiplier>
			</li>
		</damageMultipliers>
	</ThingDef>
